generator client {
    provider = "prisma-client-js"
}

model User {
    id        String @id @default(cuid())
    email     String @unique
    name      String?
    password  String?
}

model Slot {
  id          String @id @default(cuid())
  Date        DateTime @db.Date
  startTime   DateTime
  endTime     DateTime
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  isAvailable Boolean @default(true)
}
