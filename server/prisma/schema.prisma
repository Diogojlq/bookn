datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id        String @id @default(cuid())
    email     String @unique
    name      String?
    password  String?
    slots     Slot[]
}

model Slot {
    id          String   @id @default(cuid())
    date        DateTime @db.Date
    startTime   DateTime
    endTime     DateTime
    userId      String?
    user        User?    @relation(fields: [userId], references: [id])
    isAvailable Boolean  @default(true)
}
