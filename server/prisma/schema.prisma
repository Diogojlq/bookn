datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id        String @id @default(cuid())
    email     String @unique
    name      String?
    password  String?
    slots     Slot[]
}

model Slot {
    id          String   @id @default(cuid())
    date        DateTime @db.Date
    startTime   DateTime
    endTime     DateTime
    userId      String?
    user        User?    @relation(fields: [userId], references: [id])
    isAvailable Boolean  @default(true)
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id])
  eventTypes  EventType[]
  slots       Slot[]
}
