datasource db {
    provider = "postgresql"
  }

generator client {
    provider = "prisma-client-js"
    output   = "..src/generated/client"
}

model User {
    id        String @id @default(cuid())
    email     String @unique
    name      String?
    password  String?
    slots     Slot[]
}

model Slot {
  id          String @id @default(cuid())
  date        DateTime @db.Date
  startTime   DateTime
  endTime     DateTime
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  isAvailable Boolean @default(true)
}
